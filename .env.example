# .env.local にコピーして値を入れる。.env.local はコミットしない。

# 記事候補の収集（scripts/collect-articles）
SEARCH_PROVIDER=exa
EXA_API_KEY=
TAVILY_API_KEY=
# 記事候補の AI の下読み（Claude Sonnet 5.5）
ANTHROPIC_API_KEY=
# 判定用スプレッドシート（#100）への追記。手順は scripts/collect-articles/README.md
GOOGLE_SHEET_ID=
# サービスアカウントの鍵の JSON を base64 にしたもの（JSON をそのまま1行で入れてもよい）
GOOGLE_SERVICE_ACCOUNT_KEY=
# 重複判定にだけ使う既存のタブ（カンマ区切り。任意）
SHEET_DEDUPE_TABS=
